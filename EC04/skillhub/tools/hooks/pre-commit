#!/bin/bash
# Hook pre-commit SkillHub - Vérification qualité code
# Bloque le commit si le code ne passe pas les contrôles

echo "🔍 Pre-commit : vérification qualité du code..."

# Les binaires vivent dans le dossier de l'application, pas a la racine du
# depot : sans ce chemin, les tests "-f vendor/bin/..." echouaient toujours
# et les controles etaient silencieusement sautes.
REPO_ROOT=$(git rev-parse --show-toplevel)
APP_DIR="$REPO_ROOT/EC04/skillhub"

# Récupérer uniquement les fichiers PHP/YAML modifiés et indexés
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(php|ya?ml)$')

if [ -z "$FILES" ]; then
    echo "✅ Aucun fichier PHP/YAML à vérifier."
    exit 0
fi

# 1. Vérification syntaxe PHP (lint)
echo "→ Vérification syntaxe PHP..."
for FILE in $FILES; do
    if [[ "$FILE" == *.php ]]; then
        php -l "$FILE" > /dev/null
        if [ $? -ne 0 ]; then
            echo "❌ Erreur de syntaxe PHP dans $FILE"
            exit 1
        fi
    fi
done

# 2. PHP-CS-Fixer (style) - si installé
if [ -f "$APP_DIR/vendor/bin/php-cs-fixer" ]; then
    echo "→ PHP-CS-Fixer..."
    (cd "$APP_DIR" && vendor/bin/php-cs-fixer fix --dry-run --diff $FILES)
    if [ $? -ne 0 ]; then
        echo "❌ PHP-CS-Fixer : style de code incorrect."
        echo "   Lance : vendor/bin/php-cs-fixer fix"
        exit 1
    fi
fi

# 3. PHPStan (analyse statique) - si installé
if [ -f "$APP_DIR/vendor/bin/phpstan" ]; then
    echo "→ PHPStan..."
    # Meme configuration qu'en integration continue (phpstan.dist.neon) :
    # un commit qui passe en local passe aussi le pipeline.
    (cd "$APP_DIR" && vendor/bin/phpstan analyse --no-progress)
    if [ $? -ne 0 ]; then
        echo "❌ PHPStan : erreurs détectées."
        exit 1
    fi
fi

echo "✅ Tous les contrôles sont passés !"
exit 0
