# =====================================================================
# Modele de configuration SkillHub.
#
# Copier ce fichier vers .env puis renseigner les valeurs reelles :
#     cp .env.example .env
#
# .env n'est jamais versionne : il contient les valeurs de production.
# Ce modele ne contient aucune valeur sensible, uniquement les noms des
# variables attendues et leur role.
# =====================================================================

# --- Application ------------------------------------------------------
# prod, dev ou test
APP_ENV=prod
# Cle de signature des cookies et des jetons Symfony.
# Generer une valeur unique par environnement :
#     php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=

# --- PostgreSQL (donnees metier) --------------------------------------
POSTGRES_VERSION=16
POSTGRES_DB=app
POSTGRES_USER=app
# Obligatoire : le demarrage des conteneurs echoue si elle est absente.
POSTGRES_PASSWORD=

# --- MongoDB (feedbacks, journal de visites) --------------------------
MONGODB_DB=app

# =====================================================================
# Secrets de la chaine d'integration continue
#
# Ceux-ci ne vivent PAS dans un fichier : ils sont stockes dans
# Settings > Secrets and variables > Actions du depot GitHub, et injectes
# dans le pipeline au moment de l'execution.
#
#   VPS_HOST     adresse du serveur de deploiement
#   VPS_USER     compte de service utilise par le deploiement
#   VPS_SSH_KEY  cle privee SSH dediee au deploiement
#   GITHUB_TOKEN fourni automatiquement par GitHub Actions
# =====================================================================
